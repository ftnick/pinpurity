{
  "manifest_version": 3,
  "name": "pinpurity",
  "version": "1.0.0",
  "description": "",
  "permissions": ["tabs", "storage"],
  "host_permissions": ["*://*.pinterest.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.pinterest.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
